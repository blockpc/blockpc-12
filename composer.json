{
    "name": "blockpc/blockpc",
    "type": "project",
    "description": "The skeleton application for Blockpc with the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "christophrumpel/missing-livewire-assertions": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "livewire/volt": "^1.0",
        "mallardduck/blade-boxicons": "^2.4",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.6",
        "laravel/breeze": "^2.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "phpunit/phpunit": "^13.4",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Blockpc\\": "Blockpc/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Packages\\": "Packages/"
        },
        "files": [
            "Blockpc/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pint": "./vendor/bin/pint",
        "phpstan": "./vendor/bin/phpstan analyse",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "./vendor/bin/sail test"
        ],
        "test-fast": [
            "./vendor/bin/sail test --exclude-group=filesystem,slow,integration -p"
        ],
        "test-slow": [
            "./vendor/bin/sail test --group=filesystem"
        ],
        "test-all": [
            "./scripts/test-optimized.sh"
        ],
        "test-filesystem": [
            "./vendor/bin/sail test --group=filesystem"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
